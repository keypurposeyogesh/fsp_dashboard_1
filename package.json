{
  "name": "fsp-member-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --test-concurrency=1 \"tests/*.cjs\" \"database/tests/*.cjs\"",
    "test:e2e": "playwright test --project=chromium --project=mobile-360 --project=tablet-768 --project=webkit",
    "test:e2e:live": "playwright test --project=live",
    "check:secrets": "node scripts/check-secrets.mjs --history",
    "check:release": "npm run check:secrets && npm test && npm run lint -- --max-warnings 0 && tsc --noEmit && npm run build -- --webpack && npm run check:secrets && npm run test:e2e && npm run test:e2e:live"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
